---
import type { Post } from "../data/posts";

interface Props {
    post: Post;
}

const { post } = Astro.props;
---

<article class="blog-card">
    <a href={`/blog/${post.slug}/`}>
        <div class="blog-image">
            <img
                src={post.image}
                alt={post.title}
                loading="lazy"
                onerror="this.style.display='none'"
            />
        </div>

        <div class="card-content">
            <time>{post.date}</time>

            <h3>{post.title}</h3>

            <p>{post.excerpt}</p>
        </div>
    </a>
</article>