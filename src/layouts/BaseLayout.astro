---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.scss";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Crave Haven",
    description = "Recipes, stories, and inspiration from Crave Haven."
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <meta name="description" content={description} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <link
            href="https://fonts.googleapis.com/css2?family=Caprasimo&family=DM+Serif+Display&family=Lora:wght@400;500;600;700&family=Roboto+Mono:wght@400;500;600&display=swap"
            rel="stylesheet"
        />

        <title>{title}</title>
    </head>

    <body>
        <Header />

        <main>
            <slot />
        </main>

        <Footer />
    </body>
</html>